<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mike.meteo.fetch</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/mikecolombet/meteo-marcq/deploy.sh</string>
    </array>

    <!-- launchd n'hérite pas de votre PATH de shell : on l'étend pour que
         "netlify" (installé via nvm) soit trouvable. Si vous changez de
         version de Node avec nvm, ce chemin devra être remis à jour
         (vérifiable avec "which netlify" dans Terminal). -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/mikecolombet/.nvm/versions/node/v24.19.0/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- se déclenche toutes les 600 secondes = 10 minutes -->
    <key>StartInterval</key>
    <integer>600</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/mikecolombet/meteo-marcq/fetch.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/mikecolombet/meteo-marcq/fetch-error.log</string>
</dict>
</plist>
